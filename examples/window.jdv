// A window with a button. Needs: sudo apt install python3-tk
Import GUI

GUI Title = Test app
GUI Size = 320x160

Define Message = GUI Text "Press the button" at 20, 20
Define Go = GUI Button "Press me" at 20, 60

Define Clicks = 0
On Go
    Set Clicks = Clicks + 1
    Set Message = Pressed {Clicks} times
End
